      "Bash(git config *)", "Bash(git remote *)",
      "Bash(pip *)", "Bash(pip3 *)", "Bash(.venv/bin/pip *)", "Bash(python -m pip *)", "Bash(.venv/bin/python -m pip *)",
      "Bash(pyenv *)", "Bash(sudo *)", "Bash(su *)",
      "Bash(curl *)", "Bash(wget *)", "Bash(ssh *)",
      "Bash(rm -rf *)",
      "WebFetch", "WebSearch"
    ]
  }
}
